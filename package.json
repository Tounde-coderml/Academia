        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.4",
        "vue-tsc": "^3.3.13"
